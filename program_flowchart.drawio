        <mxCell id="state-preflight" value="PRE-FLIGHT&#xa;&#xa;• Waiting on ground&#xa;• GPS fix acquisition&#xa;• System checks&#xa;• WiFi AP active" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=5" vertex="1" parent="fsm-group">
